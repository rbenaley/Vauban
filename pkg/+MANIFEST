name = "vauban";
version = "%%VERSION%%";
origin = "security/vauban";
comment = "Security bastion platform with SSH (asciicast) and RDP (fMP4) recording, RBAC, audit";
maintainer = "none@freebsd.org";
www = "https://github.com/rbenaley/Vauban";
prefix = "/usr/local";
licenselogic = "single";
licenses = ["BSD2CLAUSE"];
categories = ["security"];

desc = <<EOD
VAUBAN is a security bastion (PAM) platform providing:
 - Privileged access management
 - SSH terminal proxying with asciicast v2 session recording and password redaction
 - RDP desktop proxying with segmented fMP4 recording and DASH playback
 - Role-based access control (RBAC)
 - Multi-factor authentication (TOTP)
 - Centralized audit logging
 - Hardened secrets vault with fine-grained access control
 - ACME certificate auto-renewal (Let's Encrypt / ZeroSSL)
 - Defense in depth with privsep and capsicum(4) sandboxing
 - Post-quantum cryptography support
EOD;

deps = {
    postgresql18-server = {
        origin = "databases/postgresql18-server";
        version = "18";
    };
};

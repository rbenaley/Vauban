#!/bin/sh
# Post-installation: directories, ACLs, vault master key, database setup.
#
# Database schema management is delegated to the embedded migration
# runner (`vauban-supervisor migrate`): baseline-aware, one transaction
# per migration, loud failure. The share/vauban/migrations/ tree is
# shipped for reference only and is never executed by this script.
#
# chmod / chown / setfacl live in privsep_fs_apply.sh driven by
# privsep_fs_layout.list. This script must not call those tools itself:
# sed -i replaces the vauban.conf inode and would destroy ACEs, so the
# layout apply runs AFTER secret_key / database url edits.

PREFIX=${PKG_PREFIX:-/usr/local}
SUPERVISOR_BIN="${PREFIX}/libexec/vauban/vauban-supervisor"
MIGRATE_CMD="${SUPERVISOR_BIN} migrate --database-url postgresql:///vauban"
LAYOUT_LIST="${PREFIX}/share/vauban/privsep_fs_layout.list"
LAYOUT_APPLY="${PREFIX}/share/vauban/privsep_fs_apply.sh"

# =========================================================================== #
# 1. Runtime directories (mkdir only -- modes come from the layout apply)     #
# =========================================================================== #
echo "==> Creating runtime directories..."

mkdir -p /var/vauban/vault
mkdir -p /var/vauban/recordings
mkdir -p /var/vauban/audit

# Tamper-evident audit WORM log ([audit] log_path). Deliberately a SEPARATE
# tree from recordings: append-only, never purged by the retention reaper.
# Written by the supervisor (root) via the FD broker. The sealed Ed25519 signing
# key is auto-generated by the supervisor on first boot (idempotent); the
# `vauban-vault seal-audit-key` command remains available for manual rotation.

# No ACLs on certs/ -- only root (vauban-supervisor) accesses cert files.
# vauban-web receives cert data via IPC at startup. The optional LDAPS trust
# anchor (certs/ldap_ca.pem, [auth.ldaps].ca_cert_file) is read here by the
# supervisor (root) and forwarded pre-seal to vauban-auth: it lives under the
# same 0700 root:wheel certs/ dir, so it needs no additional ACE in the
# catalogue.

# =========================================================================== #
# 4. Production configuration                                               #
# =========================================================================== #
CONF="${PREFIX}/etc/vauban/vauban.conf"

SECRET_KEY=$(grep -m1 '^secret_key' "${CONF}" 2>/dev/null | sed 's/.*= *"//;s/"$//')
if [ -z "${SECRET_KEY}" ] || [ "${SECRET_KEY}" = "CHANGE-ME-IN-PRODUCTION-32-CHARS!" ]; then
    SECRET_KEY=$(openssl rand -base64 32)
    sed -i '' '/^# secret_key is injected/d; /^# For manual setup, replace/d' "${CONF}"
    if grep -q '^secret_key' "${CONF}" 2>/dev/null; then
        sed -i '' "s|^secret_key = .*|secret_key = \"${SECRET_KEY}\"|" "${CONF}"
    else
        sed -i '' "1,/^bin_path/{/^bin_path/a\\
secret_key = \"${SECRET_KEY}\"
;}" "${CONF}"
    fi
    echo "  Generated secret_key in ${CONF}"
fi

# =========================================================================== #
# 5. Vault master key                                                        #
# =========================================================================== #
echo "==> Setting up vault..."

if [ ! -f /var/vauban/vault/master.key ]; then
    dd if=/dev/random of=/var/vauban/vault/master.key bs=32 count=1 2>/dev/null
    echo "  Generated new vault master key: /var/vauban/vault/master.key"
    echo "  IMPORTANT: back up this key. Loss means encrypted data is unrecoverable."
else
    echo "  Vault master key already exists -- skipping generation."
fi

# =========================================================================== #
# 6. PostgreSQL database setup                                               #
#    Schema creation and upgrades both go through the embedded runner       #
#    (`vauban-supervisor migrate`). It runs as the postgres superuser via   #
#    the local socket, applies one transaction per migration, and exits     #
#    non-zero on ANY failure -- which fails this whole post-install (see    #
#    the DB_SETUP_FAILED check at the end of this script). No silent        #
#    errors, no partial schemas.                                            #
# =========================================================================== #
echo "==> Checking PostgreSQL..."

DB_SETUP_FAILED=0

report_migrate_failure() {
    DB_SETUP_FAILED=1
    echo ""
    echo "  ***************************************************************"
    echo "  * ERROR: Vauban database migration FAILED.                    *"
    echo "  * The error is printed above. Vauban services WILL NOT start  *"
    echo "  * until the schema is complete.                               *"
    echo "  *                                                             *"
    echo "  * The runner is resumable: migrations already applied are     *"
    echo "  * tracked and skipped. Fix the cause, then re-run:            *"
    echo "  *   su -m postgres -c \"${MIGRATE_CMD}\"                       *"
    echo "  ***************************************************************"
    echo ""
}

if ! service postgresql status >/dev/null 2>&1; then
    echo "  WARNING: PostgreSQL is not running."
    echo "  The Vauban database schema has NOT been provisioned."
    echo "  Start PostgreSQL:  service postgresql start"
    echo "  Then run the database setup manually:"
    echo "    su -m postgres -c \"${MIGRATE_CMD}\""
else
    DB_EXISTS=$(su -m postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='vauban'\"" 2>/dev/null || true)

    if [ "$DB_EXISTS" != "1" ]; then
        DB_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

        su -m postgres -c "createdb vauban" >/dev/null
        su -m postgres -c "psql -q -c \"CREATE USER vauban WITH PASSWORD '${DB_PASSWORD}';\""
        su -m postgres -c "psql -q -c \"GRANT ALL PRIVILEGES ON DATABASE vauban TO vauban;\""
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON SCHEMA public TO vauban; ALTER SCHEMA public OWNER TO vauban;\""

        echo "  Fresh install: applying full schema via the embedded runner..."
        if su -m postgres -c "${MIGRATE_CMD}"; then
            echo "  Database schema applied successfully."
        else
            report_migrate_failure
        fi

        su -m postgres -c "psql -q -d vauban -c \"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO vauban; ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO vauban;\""
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON ALL TABLES IN SCHEMA public TO vauban; GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO vauban;\""

        sed -i '' '/^# url is injected/d; /^# For manual setup: url/d' "${CONF}"
        sed -i '' 's|^url = "postgresql://.*|url = "postgresql://vauban:'"${DB_PASSWORD}"'@localhost/vauban"|' "${CONF}"

        echo "  Database created and configured in ${CONF}"
    else
        echo "  Database 'vauban' already exists -- applying pending migrations..."
        if su -m postgres -c "${MIGRATE_CMD}"; then
            echo "  Database schema is up to date."
        else
            report_migrate_failure
        fi
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON ALL TABLES IN SCHEMA public TO vauban; GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO vauban;\""
    fi
fi

# =========================================================================== #
# 6b. Rotate insecure default DB password                                    #
#     Detects "vauban" or "CHANGE-ME" as the DB password and replaces it     #
#     with a random one (requires PostgreSQL running).                       #
# =========================================================================== #
CURRENT_DB_PASS=$(grep -m1 '^url' "${CONF}" 2>/dev/null \
    | sed -n 's|.*://vauban:\([^@]*\)@.*|\1|p')

if [ "${CURRENT_DB_PASS}" = "vauban" ] || [ "${CURRENT_DB_PASS}" = "CHANGE-ME" ]; then
    if service postgresql status >/dev/null 2>&1; then
        NEW_DB_PASS=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

        su -m postgres -c \
            "psql -q -c \"ALTER USER vauban WITH PASSWORD '${NEW_DB_PASS}';\""

        sed -i '' 's|^url = "postgresql://.*|url = "postgresql://vauban:'"${NEW_DB_PASS}"'@localhost/vauban"|' "${CONF}"

        echo "  SECURITY: rotated insecure default database password."
    else
        echo "  WARNING: database password is the insecure default."
        echo "  Start PostgreSQL and re-install the package to auto-rotate it,"
        echo "  or change it manually with:"
        echo "    psql -U postgres -c \"ALTER USER vauban WITH PASSWORD '<new>';\""
        echo "    Then update url in ${CONF}"
    fi
fi

# =========================================================================== #
# 7. Layout apply (modes + ACEs)                                             #
#    Must run AFTER all sed -i operations (secret_key, database url)          #
#    because sed -i replaces the file, destroying existing ACLs.             #
# =========================================================================== #
# shellcheck disable=SC1090
. "${LAYOUT_APPLY}"
apply_privsep_layout "${PREFIX}" "${LAYOUT_LIST}" || {
    echo "ERROR: failed to apply privsep filesystem layout." >&2
    exit 1
}

# =========================================================================== #
# 8. Summary                                                                 #
# =========================================================================== #
echo ""
echo "================================================================"
echo "  Vauban %%VERSION%% installed."
echo ""
echo "  Session recording (when [recording] enabled in vauban.conf):"
echo "    - SSH: asciicast v2 (.cast) under /var/vauban/recordings, web playback"
echo "    - RDP: segmented fMP4 + meta.json, DASH playback in the admin UI"
echo ""
echo "  Next steps:"
echo "    1. Edit ${CONF}:"
echo "       - To enable ACME: set enabled=true, email and domains"
echo "         in [server.tls.acme]"
echo "    2. sysrc vauban_enable=YES"
echo "    3. service vauban start"
echo "    4. vauban-supervisor create-superuser"
echo "================================================================"
echo ""

# Fail the post-install script if the database schema could not be applied,
# so `pkg add` / `pkg install` reports a visible POST-INSTALL failure
# instead of a clean install on top of a broken database.
if [ "${DB_SETUP_FAILED}" = "1" ]; then
    echo "ERROR: Vauban post-install completed WITH ERRORS: the database"
    echo "schema was NOT applied correctly (see messages above)."
    exit 1
fi

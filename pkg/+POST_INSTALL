#!/bin/sh
# Post-installation: directories, ACLs, vault master key, database setup.

PREFIX=${PKG_PREFIX:-/usr/local}
MIGRATION_DIR="${PREFIX}/share/vauban/migrations"

# --------------------------------------------------------------------------- #
# ACL helper -- detects NFSv4 (ZFS) vs POSIX.1e (UFS) via filesystem type    #
# --------------------------------------------------------------------------- #
_acl_type=""

detect_acl_type() {
    _fs=$(stat -f %HT "$1" 2>/dev/null)
    case "$_fs" in
        zfs) _acl_type="nfsv4" ;;
        *)   _acl_type="posix" ;;
    esac
}

set_acl() {
    _user=$1; _perms=$2; _path=$3
    case "$_acl_type" in
        nfsv4) setfacl -m "u:${_user}:${_perms}::allow" "$_path" ;;
        *)     setfacl -m "u:${_user}:${_perms}" "$_path" ;;
    esac
}

set_default_acl() {
    _user=$1; _perms=$2; _path=$3
    case "$_acl_type" in
        nfsv4) setfacl -m "u:${_user}:${_perms}:fd:allow" "$_path" ;;
        *)     setfacl -d -m "u:${_user}:${_perms}" "$_path" ;;
    esac
}

# =========================================================================== #
# 1. Runtime directories                                                      #
# =========================================================================== #
echo "==> Creating runtime directories..."

mkdir -p /var/vauban/vault
mkdir -p /var/vauban/recordings

chown root:vauban-vault /var/vauban/vault
chmod 750 /var/vauban/vault

chown root:wheel /var/vauban/recordings
chmod 750 /var/vauban/recordings

# =========================================================================== #
# 2. ACLs -- /usr/local/etc/vauban  (all services)                           #
#            /usr/local/etc/vauban/certs  (vauban-web only)                   #
# =========================================================================== #
echo "==> Setting ACLs on configuration directories..."

chown root:wheel "${PREFIX}/etc/vauban"
chmod 750 "${PREFIX}/etc/vauban"
chown root:wheel "${PREFIX}/etc/vauban/certs"
chmod 750 "${PREFIX}/etc/vauban/certs"

detect_acl_type "${PREFIX}/etc/vauban"

_svc_users="vauban-audit vauban-vault vauban-rbac vauban-auth vauban-proxy-ssh vauban-proxy-rdp vauban-web"

for _u in ${_svc_users}; do
    set_acl         "$_u" "rx" "${PREFIX}/etc/vauban"
    set_default_acl "$_u" "r"  "${PREFIX}/etc/vauban"
done

set_acl         "vauban-web" "rx" "${PREFIX}/etc/vauban/certs"
set_default_acl "vauban-web" "r"  "${PREFIX}/etc/vauban/certs"

# =========================================================================== #
# 3. ACLs -- /var/vauban/recordings                                          #
# =========================================================================== #
echo "==> Setting ACLs on recordings directory..."

detect_acl_type /var/vauban/recordings

for _u in vauban-audit vauban-web; do
    set_acl         "$_u" "rx" /var/vauban/recordings
    set_default_acl "$_u" "r"  /var/vauban/recordings
done

# =========================================================================== #
# 4. Production configuration                                               #
# =========================================================================== #
CONF="${PREFIX}/etc/vauban/production.toml"

if [ ! -f "${CONF}" ]; then
    echo "==> Generating production configuration..."
    cp "${CONF}.sample" "${CONF}"
    chmod 640 "${CONF}"

    SECRET_KEY=$(openssl rand -base64 32)
    sed -i '' "s|^# secret_key must be set.*|secret_key = \"${SECRET_KEY}\"|" "${CONF}"
    echo "  Generated secret_key in ${CONF}"
else
    echo "==> Production configuration already exists -- skipping."
fi

# =========================================================================== #
# 5. Vault master key                                                        #
# =========================================================================== #
echo "==> Setting up vault..."

chown root:vauban-vault /var/vauban/vault
chmod 750 /var/vauban/vault

if [ ! -f /var/vauban/vault/master.key ]; then
    dd if=/dev/random of=/var/vauban/vault/master.key bs=32 count=1 2>/dev/null
    chown root:vauban-vault /var/vauban/vault/master.key
    chmod 440 /var/vauban/vault/master.key
    echo "  Generated new vault master key: /var/vauban/vault/master.key"
    echo "  IMPORTANT: back up this key. Loss means encrypted data is unrecoverable."
else
    echo "  Vault master key already exists -- skipping generation."
fi

# =========================================================================== #
# 6. PostgreSQL database setup                                               #
# =========================================================================== #
echo "==> Checking PostgreSQL..."

if ! service postgresql status >/dev/null 2>&1; then
    echo "  WARNING: PostgreSQL is not running."
    echo "  Start it with:  service postgresql start"
    echo "  Then re-run post-install:  pkg info -D vauban"
else
    DB_EXISTS=$(su -m postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='vauban'\"" 2>/dev/null || true)

    if [ "$DB_EXISTS" != "1" ]; then
        DB_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

        su -m postgres -c "createdb vauban"
        su -m postgres -c "psql -c \"CREATE USER vauban WITH PASSWORD '${DB_PASSWORD}';\""
        su -m postgres -c "psql -c \"GRANT ALL PRIVILEGES ON DATABASE vauban TO vauban;\""
        su -m postgres -c "psql -d vauban -c \"GRANT ALL ON SCHEMA public TO vauban; ALTER SCHEMA public OWNER TO vauban;\""

        for _mig in $(ls -d "${MIGRATION_DIR}"/*/ 2>/dev/null | sort); do
            if [ -f "${_mig}/up.sql" ]; then
                su -m postgres -c "psql -d vauban -f '${_mig}/up.sql'" 2>/dev/null
            fi
        done

        sed -i '' '/^\[database\]/a\
url = "postgresql://vauban:'"${DB_PASSWORD}"'@localhost/vauban"
' "${CONF}"

        echo "  Database created and configured in ${CONF}"
    else
        echo "  Database 'vauban' already exists -- applying migrations..."
        for _mig in $(ls -d "${MIGRATION_DIR}"/*/ 2>/dev/null | sort); do
            if [ -f "${_mig}/up.sql" ]; then
                su -m postgres -c "psql -d vauban -f '${_mig}/up.sql'" 2>/dev/null || true
            fi
        done
        echo "  Migrations applied (existing objects skipped)."
    fi
fi

# =========================================================================== #
# 7. Summary                                                                 #
# =========================================================================== #
echo ""
echo "================================================================"
echo "  Vauban %%VERSION%% installed."
echo ""
echo "  Next steps:"
echo "    1. Edit ${CONF}"
echo "       (ACME domain/email, trusted_proxies, ...)"
echo "    2. Place TLS certificates in ${PREFIX}/etc/vauban/certs/"
echo "       (or enable ACME in production.toml)"
echo "    3. sysrc vauban_enable=YES"
echo "    4. service vauban start"
echo "    5. create_superuser"
echo "================================================================"
echo ""

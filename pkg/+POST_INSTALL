#!/bin/sh
# Post-installation: dirs, FACLs, DB setup, migration.
#
# Package version: %%VERSION%%

PREFIX=${PKG_PREFIX:-/usr/local}
CONF_DIR="${PREFIX}/etc/vcp"
ACL_SH="${PREFIX}/libexec/vcp/acl.sh"
VCP_BIN="${PREFIX}/bin/vcp"

# shellcheck source=/usr/local/libexec/vcp/acl.sh
. "${ACL_SH}"

echo "==> Creating runtime directories..."
mkdir -p /var/db/vcp/portal /var/db/vcp/storage /var/empty
chmod 555 /var/empty
chown root:wheel /var/db/vcp
chmod 755 /var/db/vcp
chown vcp:vcp /var/db/vcp/portal
chmod 755 /var/db/vcp/portal
chown vcp-storage:vcp-storage /var/db/vcp/storage
chmod 0700 /var/db/vcp/storage

mkdir -p /var/run/vcp
prepare_vcp_run_dir /var/run/vcp

mkdir -p "${CONF_DIR}/certs" "${CONF_DIR}/access"
chown root:wheel "${CONF_DIR}"
chmod 755 "${CONF_DIR}"
chown root:wheel "${CONF_DIR}/certs"
chmod 700 "${CONF_DIR}/certs"
ensure_portal_cert_acl "${CONF_DIR}/certs" "vcp"

# Portal must read conf + policy; helper reads vcp-store.conf.
detect_acl_type "${CONF_DIR}"
set_acl "vcp" "rx" "${CONF_DIR}"
set_acl "vcp-storage" "rx" "${CONF_DIR}"
set_default_acl "vcp" "r" "${CONF_DIR}"
set_default_acl "vcp-storage" "r" "${CONF_DIR}"

if [ -f "${CONF_DIR}/vcp.conf" ]; then
    chown root:wheel "${CONF_DIR}/vcp.conf"
    chmod 640 "${CONF_DIR}/vcp.conf"
    detect_acl_type "${CONF_DIR}/vcp.conf"
    set_acl "vcp" "r" "${CONF_DIR}/vcp.conf"
fi
if [ -f "${CONF_DIR}/vcp-store.conf" ]; then
    chown root:wheel "${CONF_DIR}/vcp-store.conf"
    chmod 640 "${CONF_DIR}/vcp-store.conf"
    detect_acl_type "${CONF_DIR}/vcp-store.conf"
    set_acl "vcp-storage" "r" "${CONF_DIR}/vcp-store.conf"
fi

touch /var/log/vcp-access.log /var/log/vcp.log /var/log/vcp-store.log
chown vcp:wheel /var/log/vcp-access.log /var/log/vcp.log
chown vcp-storage:wheel /var/log/vcp-store.log
chmod 640 /var/log/vcp-access.log /var/log/vcp.log /var/log/vcp-store.log

# --------------------------------------------------------------------------- #
# PostgreSQL role + database + migrations                                     #
# --------------------------------------------------------------------------- #
# Packaged vcp.conf always ships the DB URL placeholder. Password injection
# happens here at pkg-add time (never at `just package` / pkg create).
# Reinstall keeps the Postgres role (see +POST_DEINSTALL) but may restore a
# fresh @config template — so when the placeholder is still present we must
# CREATE or ALTER USER and rewrite the URL, not skip because the role exists.
_DB_URL_PLACEHOLDER='postgresql://vcp:CHANGE-ME@localhost/vcp'

_inject_db_password() {
    _pass="$1"
    if [ ! -f "${CONF_DIR}/vcp.conf" ]; then
        return 0
    fi
    if ! grep -qF "${_DB_URL_PLACEHOLDER}" "${CONF_DIR}/vcp.conf"; then
        return 0
    fi
    _esc=$(printf '%s' "${_pass}" | sed 's/[&/\]/\\&/g')
    sed -i '' "s|${_DB_URL_PLACEHOLDER}|postgresql://vcp:${_esc}@localhost/vcp|" \
        "${CONF_DIR}/vcp.conf"
    detect_acl_type "${CONF_DIR}/vcp.conf"
    set_acl "vcp" "r" "${CONF_DIR}/vcp.conf"
}

echo "==> Checking PostgreSQL..."
if su -m postgres -c "psql -Atc 'SELECT 1'" >/dev/null 2>&1; then
    _role_exists=0
    if su -m postgres -c "psql -Atc \"SELECT 1 FROM pg_roles WHERE rolname='vcp'\"" | grep -q 1; then
        _role_exists=1
    fi

    if [ -f "${CONF_DIR}/vcp.conf" ] \
        && grep -qF "${_DB_URL_PLACEHOLDER}" "${CONF_DIR}/vcp.conf"; then
        # openssl base64 minus /+= => URL-safe for the postgres:// userinfo.
        _pass=$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)
        if [ "${_role_exists}" -eq 0 ]; then
            echo "==> Creating PostgreSQL role and database 'vcp'..."
            su -m postgres -c "psql -v ON_ERROR_STOP=1" <<SQL
CREATE USER vcp WITH PASSWORD '${_pass}';
CREATE DATABASE vcp OWNER vcp;
SQL
        else
            echo "==> Resetting PostgreSQL password for existing role 'vcp'..."
            su -m postgres -c "psql -v ON_ERROR_STOP=1" <<SQL
ALTER USER vcp WITH PASSWORD '${_pass}';
SQL
            if ! su -m postgres -c "psql -Atc \"SELECT 1 FROM pg_database WHERE datname='vcp'\"" | grep -q 1; then
                echo "==> Creating missing database 'vcp'..."
                su -m postgres -c "psql -v ON_ERROR_STOP=1 -c \"CREATE DATABASE vcp OWNER vcp;\""
            fi
        fi
        _inject_db_password "${_pass}"
    elif [ "${_role_exists}" -eq 0 ]; then
        echo "WARNING: PostgreSQL role 'vcp' is missing and ${CONF_DIR}/vcp.conf"
        echo "  has no ${_DB_URL_PLACEHOLDER} placeholder; provision the role/DB"
        echo "  manually before starting the portal."
    fi

    echo "==> Applying Toasty migrations..."
    export VCP_CONFIG_DIR="${CONF_DIR}"
    export VCP_PACKAGE_ROOT="${PREFIX}/share/vcp"
    export VCP_ENVIRONMENT=production
    if ! "${VCP_BIN}" migration apply; then
        echo "ERROR: DB_SETUP_FAILED — vcp migration apply failed" >&2
        exit 1
    fi
else
    echo "WARNING: PostgreSQL not reachable; skip DB setup."
    echo "  Later: sysrc postgresql_enable=YES && service postgresql start"
    echo "  Then:  reinstall the package (or restore ${_DB_URL_PLACEHOLDER}"
    echo "         in ${CONF_DIR}/vcp.conf and re-run pkg-add post-install),"
    echo "         or: VCP_CONFIG_DIR=${CONF_DIR} VCP_PACKAGE_ROOT=${PREFIX}/share/vcp \\"
    echo "         VCP_ENVIRONMENT=production ${VCP_BIN} migration apply"
fi

echo ""
echo "================================================================"
echo "  VCP %%VERSION%% installed."
echo ""
echo "  Enable and start (helper before portal):"
echo "    sysrc vcp_store_enable=YES"
echo "    sysrc vcp_enable=YES"
echo "    service vcp_store start"
echo "    service vcp start"
echo ""
echo "  Edit secrets in ${CONF_DIR}/vcp.conf (DB URL, SMTP)."
echo "  Align webauthn_origin with the public HTTPS name."
echo ""
echo "  Port 443 as unprivileged uid vcp uses mac_portacl(4); rc.d loads it."
echo "  Listening on a port >= 1024? sysrc vcp_portacl_enable=NO"
echo "================================================================"
echo ""

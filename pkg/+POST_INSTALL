#!/bin/sh
# Post-installation: directories, ACLs, vault master key, database setup.

PREFIX=${PKG_PREFIX:-/usr/local}
MIGRATION_DIR="${PREFIX}/share/vauban/migrations"

# --------------------------------------------------------------------------- #
# ACL helpers -- detects NFSv4 (ZFS) vs POSIX.1e (UFS) via filesystem type   #
#                                                                             #
# Default (inheritable) ACLs are applied best-effort: some UFS configs do    #
# not support them (acl_calc_mask EINVAL).  Access ACLs are mandatory.       #
# --------------------------------------------------------------------------- #
_acl_type=""

detect_acl_type() {
    _fs=$(stat -f %HT "$1" 2>/dev/null)
    case "$_fs" in
        zfs) _acl_type="nfsv4" ;;
        *)   _acl_type="posix" ;;
    esac
}

set_acl() {
    _user=$1; _perms=$2; _path=$3
    case "$_acl_type" in
        nfsv4) setfacl -m "u:${_user}:${_perms}::allow" "$_path" ;;
        *)     setfacl -m "u:${_user}:${_perms}" "$_path" ;;
    esac
}

set_default_acl() {
    _user=$1; _perms=$2; _path=$3
    case "$_acl_type" in
        nfsv4) setfacl -m "u:${_user}:${_perms}:fd:allow" "$_path" 2>/dev/null ;;
        *)     setfacl -d -m "u:${_user}:${_perms}" "$_path" 2>/dev/null ;;
    esac
}

# =========================================================================== #
# 1. Runtime directories                                                      #
# =========================================================================== #
echo "==> Creating runtime directories..."

mkdir -p /var/vauban/vault
mkdir -p /var/vauban/recordings

chown root:vbvaultsvc /var/vauban/vault
chmod 750 /var/vauban/vault

chown root:wheel /var/vauban/recordings
chmod 750 /var/vauban/recordings

# =========================================================================== #
# 2. Permissions -- /usr/local/etc/vauban  (all services)                    #
#                   /usr/local/etc/vauban/certs  (vbwebfront only)           #
#                   /var/vauban/recordings  (audit + web)                    #
# =========================================================================== #
echo "==> Setting ACLs on configuration directories..."

chown root:wheel "${PREFIX}/etc/vauban"
chmod 750 "${PREFIX}/etc/vauban"
chown root:wheel "${PREFIX}/etc/vauban/certs"
chmod 700 "${PREFIX}/etc/vauban/certs"

detect_acl_type "${PREFIX}/etc/vauban"

_svc_users="vbauditsvc vbvaultsvc vbpolicyba vbauthenti vbproxyssh vbproxyrdp vbwebfront"
for _u in ${_svc_users}; do
    set_acl         "$_u" "rx" "${PREFIX}/etc/vauban"
    set_default_acl "$_u" "r"  "${PREFIX}/etc/vauban"
done

set_acl         "vbwebfront" "rx" "${PREFIX}/etc/vauban/certs"
set_default_acl "vbwebfront" "r"  "${PREFIX}/etc/vauban/certs"

# Bootstrap self-signed certificate (replaced by ACME on first run)
CERT_DIR="${PREFIX}/etc/vauban/certs"
if [ ! -f "${CERT_DIR}/server.crt" ]; then
    echo "==> Generating bootstrap TLS certificate..."
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
        -keyout "${CERT_DIR}/server.key" \
        -out "${CERT_DIR}/server.crt" \
        -days 1 -nodes \
        -subj "/CN=vauban-bootstrap" 2>/dev/null
    chmod 600 "${CERT_DIR}/server.key" "${CERT_DIR}/server.crt"
    setfacl -m u:vbwebfront:r-- "${CERT_DIR}/server.crt" 2>/dev/null
    setfacl -m u:vbwebfront:r-- "${CERT_DIR}/server.key" 2>/dev/null
    echo "  Generated self-signed bootstrap certificate (ACME will replace it)"
fi

echo "==> Setting ACLs on recordings directory..."

detect_acl_type /var/vauban/recordings
for _u in vbauditsvc vbwebfront; do
    set_acl         "$_u" "rx" /var/vauban/recordings
    set_default_acl "$_u" "r"  /var/vauban/recordings
done

# =========================================================================== #
# 4. Production configuration                                               #
# =========================================================================== #
CONF="${PREFIX}/etc/vauban/vauban.conf"

chown root:wheel "${CONF}"
chmod 600 "${CONF}"

detect_acl_type "${CONF}"
for _u in ${_svc_users}; do
    set_acl "$_u" "r" "${CONF}"
done

SECRET_KEY=$(grep -m1 '^secret_key' "${CONF}" 2>/dev/null | sed 's/.*= *"//;s/"$//')
if [ -z "${SECRET_KEY}" ] || [ "${SECRET_KEY}" = "CHANGE-ME-IN-PRODUCTION-32-CHARS!" ]; then
    SECRET_KEY=$(openssl rand -base64 32)
    sed -i '' '/^# secret_key is injected/d; /^# For manual setup, replace/d' "${CONF}"
    if grep -q '^secret_key' "${CONF}" 2>/dev/null; then
        sed -i '' "s|^secret_key = .*|secret_key = \"${SECRET_KEY}\"|" "${CONF}"
    else
        sed -i '' "1,/^bin_path/{/^bin_path/a\\
secret_key = \"${SECRET_KEY}\"
;}" "${CONF}"
    fi
    echo "  Generated secret_key in ${CONF}"
fi

# =========================================================================== #
# 5. Vault master key                                                        #
# =========================================================================== #
echo "==> Setting up vault..."

chown root:vbvaultsvc /var/vauban/vault
chmod 750 /var/vauban/vault

if [ ! -f /var/vauban/vault/master.key ]; then
    dd if=/dev/random of=/var/vauban/vault/master.key bs=32 count=1 2>/dev/null
    chown root:vbvaultsvc /var/vauban/vault/master.key
    chmod 440 /var/vauban/vault/master.key
    echo "  Generated new vault master key: /var/vauban/vault/master.key"
    echo "  IMPORTANT: back up this key. Loss means encrypted data is unrecoverable."
else
    echo "  Vault master key already exists -- skipping generation."
fi

# =========================================================================== #
# 6. PostgreSQL database setup                                               #
# =========================================================================== #
echo "==> Checking PostgreSQL..."

if ! service postgresql status >/dev/null 2>&1; then
    echo "  WARNING: PostgreSQL is not running."
    echo "  Start it with:  service postgresql start"
    echo "  Then re-run post-install:  pkg info -D vauban"
else
    DB_EXISTS=$(su -m postgres -c "psql -tAc \"SELECT 1 FROM pg_database WHERE datname='vauban'\"" 2>/dev/null || true)

    if [ "$DB_EXISTS" != "1" ]; then
        DB_PASSWORD=$(openssl rand -base64 24 | tr -d '/+=' | head -c 32)

        su -m postgres -c "createdb vauban" >/dev/null
        su -m postgres -c "psql -q -c \"CREATE USER vauban WITH PASSWORD '${DB_PASSWORD}';\""
        su -m postgres -c "psql -q -c \"GRANT ALL PRIVILEGES ON DATABASE vauban TO vauban;\""
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON SCHEMA public TO vauban; ALTER SCHEMA public OWNER TO vauban;\""

        for _mig in $(ls -d "${MIGRATION_DIR}"/*/ 2>/dev/null | sort); do
            if [ -f "${_mig}/up.sql" ]; then
                su -m postgres -c "psql -q -d vauban -f '${_mig}/up.sql'" 2>/dev/null
            fi
        done

        su -m postgres -c "psql -q -d vauban -c \"ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO vauban; ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO vauban;\""
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON ALL TABLES IN SCHEMA public TO vauban; GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO vauban;\""

        sed -i '' '/^# url is injected/d; /^# For manual setup: url/d' "${CONF}"
        if grep -q '^url' "${CONF}" 2>/dev/null; then
            sed -i '' "s|^url = .*|url = \"postgresql://vauban:${DB_PASSWORD}@localhost/vauban\"|" "${CONF}"
        else
            sed -i '' '/^\[database\]/a\
url = "postgresql://vauban:'"${DB_PASSWORD}"'@localhost/vauban"
' "${CONF}"
        fi

        echo "  Database created and configured in ${CONF}"
    else
        echo "  Database 'vauban' already exists -- applying migrations..."
        for _mig in $(ls -d "${MIGRATION_DIR}"/*/ 2>/dev/null | sort); do
            if [ -f "${_mig}/up.sql" ]; then
                su -m postgres -c "psql -q -d vauban -f '${_mig}/up.sql'" 2>/dev/null || true
            fi
        done
        su -m postgres -c "psql -q -d vauban -c \"GRANT ALL ON ALL TABLES IN SCHEMA public TO vauban; GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO vauban;\""
        echo "  Migrations applied (existing objects skipped)."
    fi
fi

# =========================================================================== #
# 7. Summary                                                                 #
# =========================================================================== #
echo ""
echo "================================================================"
echo "  Vauban %%VERSION%% installed."
echo ""
echo "  Next steps:"
echo "    1. Edit ${CONF}:"
echo "       - To enable ACME: set enabled=true, email and domains"
echo "         in [server.tls.acme]"
echo "    2. sysrc vauban_enable=YES"
echo "    3. service vauban start"
echo "    4. create_superuser"
echo "================================================================"
echo ""

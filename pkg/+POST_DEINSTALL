#!/bin/sh
# Inform the administrator about leftovers that require manual cleanup.

echo ""
echo "================================================================"
echo "  Vauban has been removed."
echo ""
echo "  The following items were NOT removed automatically:"
echo "    - System accounts  : vauban-{audit,vault,rbac,auth,proxy-ssh,proxy-rdp,web}"
echo "    - PostgreSQL DB    : database 'vauban' and role 'vauban'"
echo "    - Runtime data     : /var/vauban/{vault,recordings}"
echo "    - Configuration    : /usr/local/etc/vauban/"
echo "    - Vault master key : /var/vauban/vault/master.key"
echo ""
echo "  To fully clean up:"
echo ""
echo "    rm -rf /var/vauban"
echo "    rm -rf /usr/local/etc/vauban"
echo "    su -m postgres -c 'dropdb vauban'"
echo "    su -m postgres -c \"psql -c \\\"DROP USER vauban;\\\"\""
echo ""
echo "    for svc in audit vault rbac auth proxy-ssh proxy-rdp web; do"
echo "      pw userdel  \"vauban-\${svc}\""
echo "      pw groupdel \"vauban-\${svc}\""
echo "    done"
echo "================================================================"
echo ""

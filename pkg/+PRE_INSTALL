#!/bin/sh
# Create Vauban service groups and users with fixed UIDs/GIDs.
# These system accounts have no login shell and no home directory.

create_group_if_missing() {
    _name=$1
    _gid=$2
    if ! pw groupshow "$_name" >/dev/null 2>&1; then
        pw groupadd -n "$_name" -g "$_gid"
        echo "  Created group ${_name} (GID ${_gid})"
    fi
}

create_user_if_missing() {
    _name=$1
    _uid=$2
    _gid=$3
    if ! pw usershow "$_name" >/dev/null 2>&1; then
        pw useradd -n "$_name" -u "$_uid" -g "$_gid" \
            -d /nonexistent -s /usr/sbin/nologin \
            -c "Vauban ${_name} service"
        echo "  Created user ${_name} (UID ${_uid}, GID ${_gid})"
    fi
}

echo "==> Creating Vauban service accounts..."

# Rename legacy account names (pre-hyphen) so UID/GID 901-907 stay stable on upgrade.
rename_legacy_account() {
    _old=$1
    _new=$2
    if pw usershow "${_old}" >/dev/null 2>&1 && ! pw usershow "${_new}" >/dev/null 2>&1; then
        echo "  Renaming legacy account ${_old} -> ${_new}"
        pw groupmod "${_old}" -n "${_new}" 2>/dev/null || true
        pw usermod "${_old}" -l "${_new}" 2>/dev/null || true
    fi
}

rename_legacy_account vbauditsvc vb-audit
rename_legacy_account vbvaultsvc vb-vault
rename_legacy_account vbpolicyba vb-access
rename_legacy_account vbauthenti vb-auth
rename_legacy_account vbproxyssh vb-ssh
rename_legacy_account vbproxyrdp vb-rdp
rename_legacy_account vbwebfront vb-web

create_group_if_missing vb-audit 901
create_group_if_missing vb-vault 902
create_group_if_missing vb-access 903
create_group_if_missing vb-auth 904
create_group_if_missing vb-ssh 905
create_group_if_missing vb-rdp 906
create_group_if_missing vb-web 907

create_user_if_missing vb-audit 901 901
create_user_if_missing vb-vault 902 902
create_user_if_missing vb-access 903 903

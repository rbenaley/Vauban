#!/bin/sh
# Create Vauban service groups and users with fixed UIDs/GIDs.
# These system accounts have no login shell and no home directory.
#
# On upgrades, the running service is stopped BEFORE the new files land
# so the database migration in +POST_INSTALL never runs under binaries
# of the previous version (no schema-N+1 / code-N window). Fresh
# installs have no rc.d script yet, so this is a no-op.

if service vauban onestatus >/dev/null 2>&1; then
    echo "==> Stopping running Vauban service before upgrade..."
    service vauban onestop || true
fi

create_group_if_missing() {
    _name=$1
    _gid=$2
    if ! pw groupshow "$_name" >/dev/null 2>&1; then
        pw groupadd -n "$_name" -g "$_gid"
        echo "  Created group ${_name} (GID ${_gid})"
    fi
}

# _service is the Vauban binary name (e.g. vauban-audit), used in passwd GECOS.
create_user_if_missing() {
    _name=$1
    _uid=$2
    _gid=$3
    _service=$4
    if ! pw usershow "$_name" >/dev/null 2>&1; then
        pw useradd -n "$_name" -u "$_uid" -g "$_gid" \
            -d /nonexistent -s /usr/sbin/nologin \
            -c "Vauban ${_service} service"
        echo "  Created user ${_name} (UID ${_uid}, GID ${_gid})"
    fi
}

# Set GECOS to match vauban-* service names (fixes legacy renames and upgrades).
set_user_gecos() {
    _login=$1
    _service=$2
    if pw usershow "${_login}" >/dev/null 2>&1; then
        pw usermod "${_login}" -c "Vauban ${_service} service"
    fi
}

echo "==> Creating Vauban service accounts..."

# Rename legacy account names (pre-hyphen) so UID/GID 901-909 stay stable on upgrade.
rename_legacy_account() {
    _old=$1
    _new=$2
    if pw usershow "${_old}" >/dev/null 2>&1 && ! pw usershow "${_new}" >/dev/null 2>&1; then
        echo "  Renaming legacy account ${_old} -> ${_new}"
        pw groupmod "${_old}" -n "${_new}" 2>/dev/null || true
        pw usermod "${_old}" -l "${_new}" 2>/dev/null || true
    fi
}

rename_legacy_account vbauditsvc vb-audit
rename_legacy_account vbvaultsvc vb-vault
rename_legacy_account vbpolicyba vb-access
rename_legacy_account vbauthenti vb-auth
rename_legacy_account vbproxyssh vb-ssh
rename_legacy_account vbproxyrdp vb-rdp
rename_legacy_account vbwebfront vb-web

create_group_if_missing vb-audit 901
create_group_if_missing vb-vault 902
create_group_if_missing vb-access 903
create_group_if_missing vb-auth 904
create_group_if_missing vb-ssh 905
create_group_if_missing vb-rdp 906
create_group_if_missing vb-web 907
create_group_if_missing vb-iacs 908
create_group_if_missing vb-mailer 909

create_user_if_missing vb-audit 901 901 vauban-audit
create_user_if_missing vb-vault 902 902 vauban-vault
create_user_if_missing vb-access 903 903 vauban-access
create_user_if_missing vb-auth 904 904 vauban-auth
create_user_if_missing vb-ssh 905 905 vauban-proxy-ssh
create_user_if_missing vb-rdp 906 906 vauban-proxy-rdp
create_user_if_missing vb-web 907 907 vauban-web
create_user_if_missing vb-iacs 908 908 vauban-proxy-iacs
create_user_if_missing vb-mailer 909 909 vauban-mailer

echo "==> Setting service account descriptions (GECOS)..."
set_user_gecos vb-audit vauban-audit
set_user_gecos vb-vault vauban-vault
set_user_gecos vb-access vauban-access
set_user_gecos vb-auth vauban-auth
set_user_gecos vb-ssh vauban-proxy-ssh
set_user_gecos vb-rdp vauban-proxy-rdp
set_user_gecos vb-web vauban-web
set_user_gecos vb-iacs vauban-proxy-iacs
set_user_gecos vb-mailer vauban-mailer

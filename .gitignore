# Rust
**/target/
**/*.rs.bk

# Environment
.env
.env.local

# Local configuration (secrets)
**/config/local.toml

# IDE — version all of `.cursor/` except design mockups (local only).
.cursor/mockups/**
!.cursor/mockups/.gitkeep
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database (local / accidental sqlite files)
*.db
*.sqlite

# Local storage helper blob root (dev; survives cargo clean)
/vcp-storage/

# Local TLS material (self-signed / ACME account)
certs/**
!certs/.gitkeep

# Local Apache CLF access logs
logs/**
!logs/.gitkeep

# FreeBSD build.rs may symlink pkg tailwindcss here for CSS resolution
/node_modules/

# Added by cargo

/target

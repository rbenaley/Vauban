# Rust
**/target/
**/*.rs.bk
Cargo.lock

# Environment
.env
.env.local

# Local configuration (secrets)
**/config/local.toml

# IDE
.idea/
.vscode/
.cursor*
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite
# Only the root-level `migrations` symlink (-> vauban-db/migrations) is
# ignored; the real migration source under vauban-db/migrations/ MUST be
# tracked so deployments stay reproducible. The leading `/` anchors the
# pattern to the repo root.
/migrations

# Logs
*.log

# TLS certificates (private keys must never be committed)
**/certs/*

# Session recordings (local development data)
recordings/

# FreeBSD package build artifacts
pkg/staging/
pkg/plist
pkg/*.pkg


# Copy to config/local.toml for personal overrides (gitignored).
# Loaded only in development, after default.toml + development.toml.

[database]
# Empty host => Unix-domain socket (no TCP).
url = "postgresql:///vcp"

# Optional: point at Scaleway TEM instead of local Mailpit.
# [mail]
# smtp_host = "smtp.tem.scaleway.com"
# smtp_port = 587
# smtp_encryption = "starttls"
# smtp_username = "YOUR-PROJECT-ID"
# smtp_password = "YOUR-IAM-SECRET-KEY"

# Optional: override magic-link retention / purge cadence.
# [magiclinks]
# token_retention_days = 7
# purge_interval_minutes = 60
